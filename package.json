{
  "name": "lms-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "postbuild": "node scripts/fix-static-export.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "format": "prettier --write src scripts tests next.config.ts eslint.config.mjs tsconfig.json",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "5.15.4",
    "next": "16.4.2",
    "pdfjs-dist": "6.3.289",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "ws": "^8.18.0"
  }
}
